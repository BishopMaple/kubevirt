{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualityflow-result.schema.json",
  "title": "QualityFlow Result",
  "description": "Structured output from the QualityFlow agent covering STP, STD, reviews, and committed test files.",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "jira_id"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "error"]
    },
    "jira_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
    },
    "stp": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "review_verdict": {
          "type": "string",
          "enum": ["APPROVED", "APPROVED_WITH_FINDINGS", "NEEDS_REVISION"]
        },
        "review_file": { "type": "string" },
        "review_score": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "std": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "review_verdict": {
          "type": "string",
          "enum": ["APPROVED", "APPROVED_WITH_FINDINGS", "NEEDS_REVISION"]
        },
        "review_file": { "type": "string" },
        "review_score": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "scenarios": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "tier1": { "type": "integer", "minimum": 0 },
        "tier2": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "stubs": {
      "type": "object",
      "properties": {
        "go": { "type": "integer", "minimum": 0 },
        "python": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "test_files_committed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commits_made": {
      "type": "integer",
      "minimum": 0
    },
    "requirements_traced": {
      "type": "integer",
      "minimum": 0
    },
    "lsp_calls": {
      "type": "integer",
      "minimum": 0
    },
    "ticket_assessment": {},
    "reason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "required": ["stp", "std", "scenarios"] }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": { "required": ["stp"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "required": ["reason"] }
    }
  ]
}
