{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-test-result.schema.json",
  "title": "Go Test Generator Result",
  "description": "Structured output from the QualityFlow Go test generator agent. Validated by the harness before the post-script runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "jira_id"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "jira_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
    },
    "test_files": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Paths to generated Go test files"
    },
    "build_verified": {
      "type": "boolean",
      "description": "Whether the generated tests passed build verification"
    },
    "lsp_patterns": {
      "type": "string",
      "description": "Path to extracted LSP patterns YAML"
    },
    "test_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of test functions generated"
    },
    "reason": {
      "type": "string",
      "enum": ["std-not-found", "config-error", "timeout", "build-failed", "no-go-scenarios"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "required": ["test_files"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "required": ["reason"] }
    }
  ]
}
